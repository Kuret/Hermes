# Allows Sunshine to acces /dev/uinput
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", GROUP="input", MODE="0660", TAG+="uaccess"

# Allows Sunshine to access /dev/uhid
KERNEL=="uhid", GROUP="input", MODE="0660", TAG+="uaccess"

# libvirtualhid's UHID controllers are renamed by kernel drivers (for example,
# hid-playstation exposes every DualSense as "Wireless Controller"), so device
# names are not a safe ownership or isolation key. Mark the HID parent from its
# physical identity, then pass that marker through input/input-event and hidraw
# children. This also grants the client-visible hidraw node without matching a
# real controller that happens to have the same name.
SUBSYSTEM=="hid", ENV{HID_PHYS}=="libvirtualhid/uhid/*", ENV{HERMES_VIRTUAL_INPUT}="1"
SUBSYSTEM=="hid", ENV{HID_PHYS}=="hermes-kms-[0-9]*", ENV{HERMES_VIRTUAL_INPUT}="1", ENV{ID_SEAT}="$env{HID_PHYS}"

# A UHID controller's input device is two levels below the HID parent. Running
# the same import for inputN and then eventN/jsN propagates both properties to
# the node consumed by libinput, SDL and games. hidraw is a direct HID child.
# Imports must be unconditional: ATTR{phys} does not exist on event/js nodes,
# and even a negative ATTR comparison does not match a missing attribute.
SUBSYSTEM=="input", IMPORT{parent}="HERMES_VIRTUAL_INPUT"
SUBSYSTEM=="input", IMPORT{parent}="ID_SEAT"
SUBSYSTEM=="hidraw", IMPORT{parent}="HERMES_VIRTUAL_INPUT"
SUBSYSTEM=="hidraw", IMPORT{parent}="ID_SEAT"

# Match inputN itself, where phys exists, then its children import this value.
# This supports broker-allocated seats beyond the old 1..8 pool.
SUBSYSTEM=="input", ATTR{phys}=="hermes-kms-[0-9]*", ENV{HERMES_VIRTUAL_INPUT}="1", ENV{ID_SEAT}="$attr{phys}"
SUBSYSTEM=="input", ENV{HERMES_VIRTUAL_INPUT}=="1", GROUP:="input", MODE:="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ENV{HERMES_VIRTUAL_INPUT}=="1", GROUP:="input", MODE:="0660", TAG+="uaccess"

# Legacy name-based joypad rules also cover the uinput fallback and older
# installations. UHID devices use the identity rules above.
KERNEL=="hidraw*", ATTRS{name}=="Sunshine PS5 (virtual) pad", GROUP="input", MODE="0660", TAG+="uaccess"
SUBSYSTEMS=="input", ATTRS{name}=="Sunshine X-Box One (virtual) pad", GROUP="input", MODE="0660", TAG+="uaccess"
SUBSYSTEMS=="input", ATTRS{name}=="Sunshine gamepad (virtual) motion sensors", GROUP="input", MODE="0660", TAG+="uaccess"
SUBSYSTEMS=="input", ATTRS{name}=="Sunshine Nintendo (virtual) pad", GROUP="input", MODE="0660", TAG+="uaccess"

SUBSYSTEM=="input", ENV{ID_SEAT}=="hermes-kms-*", TAG+="seat", GROUP:="input", MODE:="0660", TAG+="uaccess"
